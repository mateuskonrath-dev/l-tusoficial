# Resend API Key - Obter em https://resend.com
# Necessário para enviar emails pelo formulário de contato
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email de destino para receber mensagens do formulário
# Default: contact@lotuscalcados.com.br
CONTACT_EMAIL=contact@lotuscalcados.com.br

# Ambiente
# Default: development
NODE_ENV=production
